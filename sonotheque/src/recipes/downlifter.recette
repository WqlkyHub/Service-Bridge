// Descente : l'inverse du riser, pour retomber après un moment fort.
recipe({
  name: 'Descente (downlifter)',
  description: 'Retombée après un impact ou en fin de séquence.',
  category: 'sfx',
  keywords: ['descente', 'downlifter', 'transition'],
  params: {
    duration: { label: 'Durée', min: 1, max: 8, default: 3, step: 0.1, unit: 's' },
    depth: { label: 'Profondeur', min: 0, max: 1, default: 0.6, step: 0.01 },
  },
  render({ p, osc, noise, filter, gain, env, chain, play, out, duration }) {
    const n = noise('white');
    const bp = filter('bandpass', 6000, 1.2);
    const ng = gain(0);
    chain(n, bp, ng, out);
    env(bp.frequency, [[0, 7000], [duration, 150]], 'exp');
    env(ng.gain, [[0, 0.0001], [0.02, 1], [duration, 0.0001]], 'exp');
    play(n, 0, duration);

    const s = osc('sine', 400);
    const sg = gain(0);
    chain(s, sg, out);
    env(s.frequency, [[0, 300 + p.depth * 500], [duration, 30]], 'exp');
    env(sg.gain, [[0, 0.0001], [0.02, 0.3 + p.depth * 0.5], [duration, 0.0001]], 'exp');
    play(s, 0, duration);
  },
});
