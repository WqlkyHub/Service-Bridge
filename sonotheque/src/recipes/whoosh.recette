// Souffle filtré qui monte puis redescend, en traversant l'espace stéréo.
recipe({
  name: 'Whoosh',
  description: 'Souffle rapide pour les transitions et les mouvements.',
  category: 'sfx',
  keywords: ['whoosh', 'transition'],
  params: {
    duration: { label: 'Durée', min: 0.2, max: 3, default: 0.8, step: 0.05, unit: 's' },
    pitch: { label: 'Hauteur', min: 200, max: 4000, default: 1200, step: 10, unit: 'Hz' },
    air: { label: 'Finesse', min: 0.5, max: 8, default: 2, step: 0.1 },
    direction: {
      label: 'Direction',
      options: [{ value: 'lr', label: 'Gauche → droite' }, { value: 'rl', label: 'Droite → gauche' }, { value: 'center', label: 'Centre' }],
      default: 'lr',
    },
  },
  render({ p, noise, filter, gain, pan, env, chain, play, out, rand, duration }) {
    const peakAt = duration * rand(0.45, 0.6);
    const src = noise('pink');
    const bp = filter('bandpass', p.pitch * 0.4, p.air);
    const lp = filter('lowpass', p.pitch * 3, 0.5);
    const g = gain(0);
    const pn = pan(0);
    chain(src, bp, lp, g, pn, out);
    env(bp.frequency, [[0, p.pitch * 0.35], [peakAt, p.pitch], [duration, p.pitch * 0.5]], 'exp');
    env(g.gain, [[0, 0.0001], [peakAt, 1], [duration, 0.0001]], 'exp');
    if (p.direction !== 'center') {
      const side = p.direction === 'rl' ? -1 : 1;
      env(pn.pan, [[0, -0.8 * side], [duration, 0.8 * side]]);
    }
    play(src, 0, duration);
  },
});
