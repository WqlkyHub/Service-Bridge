// Pop / bulle : petite note qui monte très vite.
recipe({
  name: 'Pop',
  description: "Bulle, apparition d'un élément, bouchon.",
  category: 'sfx',
  keywords: ['pop', 'bulle', 'apparition'],
  params: {
    pitch: { label: 'Hauteur', min: 200, max: 1500, default: 500, step: 5, unit: 'Hz' },
    count: { label: 'Nombre', min: 1, max: 8, default: 1, step: 1 },
    spacing: { label: 'Écart', min: 0.05, max: 0.4, default: 0.12, step: 0.01, unit: 's' },
  },
  duration: (p) => 0.15 + (p.count - 1) * p.spacing,
  render({ p, osc, gain, env, chain, play, out, rand }) {
    for (let i = 0; i < p.count; i++) {
      const t = i * p.spacing;
      const f = p.pitch * rand(0.85, 1.2);
      const o = osc('sine', f);
      const g = gain(0);
      chain(o, g, out);
      env(o.frequency, [[t, f], [t + 0.04, f * 3]], 'exp');
      env(g.gain, [[t, 0.0001], [t + 0.003, 1], [t + 0.07, 0.0001]], 'exp');
      play(o, t, t + 0.1);
    }
  },
});
